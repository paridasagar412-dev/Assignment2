<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Published Blog Posts</title>
<style>
body{font-family:Arial,sans-serif;max-width:900px;margin:35px auto;padding:0 18px;background:#f5f7fb;color:#202938}
header{display:flex;justify-content:space-between;align-items:center;gap:12px}.post{background:white;padding:20px;margin:16px 0;border-radius:12px;box-shadow:0 2px 9px #0001}
img{max-width:100%;max-height:280px;border-radius:8px}a{color:#2457c5} .muted{color:#687386}
</style></head>
<body>
<header><h1>Published Blog Posts</h1><a href="/login">Login</a></header>
<% if (posts.length === 0) { %><p>No published posts yet.</p><% } %>
<% posts.forEach(post => { %>
<article class="post">
  <h2><%= post.title %></h2>
  <p class="muted">By <%= post.author ? post.author.name : "Unknown author" %> · <%= new Date(post.createdAt).toLocaleDateString() %></p>
  <% if (post.image) { %><img src="<%= post.image %>" alt="Featured image"><% } %>
  <p><%= post.content %></p>
  <% if (post.tags && post.tags.length) { %><p class="muted">Tags: <%= post.tags.join(", ") %></p><% } %>
</article>
<% }) %>
</body></html>